@page "/"
@inject GoogleBooksService BooksService
@inject AppDbContext Db
@rendermode InteractiveServer


<div class="landing-container" style="height:600px;overflow-y:scroll">

    <h1 class="landing-title">Welcome To Book Organizer</h1>

    <input class="search-input" placeholder="Enter ISBN..." @bind="isbn" />

    <button class="search-button" @onclick="SearchBook">
        Search
    </button>

    @if (!string.IsNullOrEmpty(error))
    {
        <p style="color:red">@error</p>
    }

    @if (book != null)
    {
        <div class="book-result">

            <div class="book-content">

                <div class="book-image">
                    @if (!string.IsNullOrEmpty(book.ImageLinks?.thumbnail))
                    {
                        <img src="@book.ImageLinks.thumbnail?.Replace("http://", "https://")" alt="Book cover" />
                    }
                    else
                    {
                        <div class="no-image">No image found</div>
                    }
                </div>

                <div class="book-text">
                    <h2>@book.Title</h2>
                    <p>@string.Join(", ", book.Authors ?? new List<string>())</p>
                    <p>@book.Description</p>
                    <button class="add-button">Add Book</button>
                </div>

            </div>

        </div>
    }

    <select @bind="selectedUserId">
    <option value="">-- Select User --</option>
    @foreach (var user in users)
    {
        <option value="@user.UserID">@user.Name</option>
    }
    </select>
    <button class="add-button" @onclick="AddBook">
    Add
    </button>
    

</div>

@code {

    string isbn = "";
    string error = "";

    VolumeInfo? book;
    List<User> users = new();
    int? selectedUserId;
    protected override async Task OnInitializedAsync()
    {
        users = await Db.Users.ToListAsync();
    }

    async Task AddBook()
    {
        if (book == null)
        {
            error = "Search for a book first.";
            return;
        }

        if (selectedUserId == null)
        {
            error = "Please select a user.";
            return;
        }

        // Extract ISBNs
        var isbn13 = book.IndustryIdentifiers?
            .FirstOrDefault(x => x.Type == "ISBN_13")?.Identifier;

        var isbn10 = book.IndustryIdentifiers?
            .FirstOrDefault(x => x.Type == "ISBN_10")?.Identifier;

        if (isbn13 == null)
        {
            error = "No ISBN13 found.";
            return;
        }

        // Check if book already exists
        var existingTitle = await Db.Titles
            .Include(t => t.BookAuthors)
            .Include(t => t.BookGenres)
            .FirstOrDefaultAsync(t => t.ISBN == isbn13);

        if (existingTitle == null)
        {
            var newTitle = new Title
            {
                ISBN = isbn13,
                ISBN10 = isbn10,
                BookName = book.Title!,
                SubTitle = book.Subtitle,
                Description = book.Description,
                Publisher = book.Publisher,
                Language = book.Language,
                PageCount = book.PageCount,
                ThumbnailNormal = book.ImageLinks?.thumbnail,
                ThumbnailSmall = book.ImageLinks?.SmallThumbnail,
                PublishedDate = ParseDate(book.PublishedDate)
            };

            // Authors
            if (book.Authors != null)
            {
                foreach (var authorName in book.Authors)
                {
                    var author = await Db.Authors
                        .FirstOrDefaultAsync(a => a.AuthorName == authorName);

                    if (author == null)
                    {
                        author = new Author { AuthorName = authorName };
                        Db.Authors.Add(author);
                        await Db.SaveChangesAsync(); // needed for ID
                    }

                    newTitle.BookAuthors.Add(new BookAuthor
                    {
                        AuthorID = author.AuthorID,
                        ISBN = isbn13
                    });
                }
            }

            // Genres
            if (book.Categories != null)
            {
                foreach (var genre in book.Categories)
                {
                    newTitle.BookGenres.Add(new BookGenre
                    {
                        Genre = genre,
                        ISBN = isbn13
                    });
                }
            }

            Db.Titles.Add(newTitle);
            await Db.SaveChangesAsync();
        }

        // Add to UserBook (avoid duplicates!)
        var exists = await Db.UserBooks
            .AnyAsync(ub => ub.ISBN == isbn13 && ub.UserID == selectedUserId);

        if (!exists)
        {
            Db.UserBooks.Add(new UserBook
            {
                ISBN = isbn13,
                UserID = selectedUserId.Value
            });

            await Db.SaveChangesAsync();
        }
    }

    DateTime? ParseDate(string? date)
    {
        if (string.IsNullOrWhiteSpace(date))
            return null;

        if (DateTime.TryParse(date, out var parsed))
            return parsed;

        return null;
    }

    async Task SearchBook()
    {
        Console.WriteLine("Button clicked");
        error = "";
        book = null;

        if (!ISBNValidator.IsValidISBN(isbn))
        {
            error = "Please enter a valid ISBN-10 or ISBN-13.";
            return;
        }

        var result = await BooksService.GetBookByISBN(isbn);

        if (result?.Items?.Count > 0)
        {
            book = result.Items[0].VolumeInfo;
        }
        else
        {
            error = "Book not found.";
        }
    }

}