@page "/search"
@using BookOrgWebapp.Data
@using BookOrgWebapp.Models
@using BookOrgWebapp.Components.Books
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components
@rendermode InteractiveServer

@inject AppDbContext Db

<PageTitle>Search</PageTitle>

<h1>Book Search</h1>

<div class="mb-3">
    <form action="/search" method="get" data-enhance data-permanent>
        <div class="input-group">
            <input class="form-control" type="search" name="searchTerm" value="@SearchTerm"
                   placeholder="Search by ISBN, Title, User, Author..." />

            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>
</div>

@if (!books.Any())
{
    <p><em>No matching books found.</em></p>
}
else
{
    <div class="book-grid">
        @foreach (var book in books)
        {
            <BookCard Book="@book" OnSelected="@(b => OpenBook(b))" />
        }
    </div>
}
@if (selectedBook != null)
{
    <BookDetailsModal Book="selectedBook" OnClose="CloseModal" OnRemoveOwner="RemoveOwner" />
}

@code {

    // Gets value from URL: /search?searchTerm=value
    [SupplyParameterFromQuery]
    private string? SearchTerm { get; set; }

    private List<Title> books = new();
    
    private Title? selectedBook;

    private async Task OpenBook(Title book)
    {
        var freshBook = await Db.Titles
            .Include(t => t.UserBooks)
                .ThenInclude(ub => ub.User)

            .Include(t => t.BookAuthors)
                .ThenInclude(ba => ba.Author)

            .Include(t => t.BookGenres)
            .FirstOrDefaultAsync(t => t.ISBN == book.ISBN);
        
        // In the rare case the book was deleted just after clicking the tile
        if (freshBook == null)
        {
            selectedBook = null;
            return;
        }

        selectedBook = freshBook;
    }

    private void CloseModal()
    {
        selectedBook = null;
    }

    private async Task LoadBooks()
    {
        var query = Db.Titles
            .Include(t => t.UserBooks)
                .ThenInclude(ub => ub.User)
            .Include(t => t.BookAuthors)
                .ThenInclude(ta => ta.Author)
            .Include(t => t.BookGenres)
            .AsSplitQuery()
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var term = SearchTerm.ToLower();

            query = query.Where(t =>
               (t.ISBN ?? "").ToLower().Contains(term)||
               (t.BookName ?? "").ToLower().Contains(term)||
               (t.SubTitle ?? "").ToLower().Contains(term)||
               (t.Description ?? "").ToLower().Contains(term)||
               (t.Publisher ?? "").ToLower().Contains(term)||
               (t.Language ?? "").ToLower().Contains(term)||
               (t.ISBN10 ?? "").ToLower().Contains(term)||
               t.BookAuthors.Any(ta => (ta.Author.AuthorName ?? "").ToLower().Contains(term))||
               t.BookGenres.Any(tg => (tg.Genre ?? "").ToLower().Contains(term))||
               t.UserBooks.Any(ub => (ub.User.Name ?? "").ToLower().Contains(term))||
               t.UserBooks.Any(ub => (ub.User.Email ?? "").ToLower().Contains(term))
            );
        }

        books = await query.ToListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = Db.Titles
            .Include(t => t.UserBooks)
                .ThenInclude(ub => ub.User)

            .Include(t => t.BookAuthors)
                .ThenInclude(ta => ta.Author)

            .Include(t => t.BookGenres)
            .AsSplitQuery()
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var term = SearchTerm.ToLower();

            // Still missing published date from query and page count
            // But they have been ommitted on purpose as they make no sense to search for. 
            // They could be a later filter you place upon a query, but not the query itself
            query = query.Where(t =>
               (t.ISBN ?? "").ToLower().Contains(term)||
               (t.BookName ?? "").ToLower().Contains(term)||
               (t.SubTitle ?? "").ToLower().Contains(term)||
               (t.Description ?? "").ToLower().Contains(term)||
               (t.Publisher ?? "").ToLower().Contains(term)||
               (t.Language ?? "").ToLower().Contains(term)||
               (t.ISBN10 ?? "").ToLower().Contains(term)||
               t.BookAuthors.Any(ta => (ta.Author.AuthorName ?? "").ToLower().Contains(term))||
               t.BookGenres.Any(tg => (tg.Genre ?? "").ToLower().Contains(term))||
               t.UserBooks.Any(ub => (ub.User.Name ?? "").ToLower().Contains(term))||
               t.UserBooks.Any(ub => (ub.User.Email ?? "").ToLower().Contains(term))
            );
        }

        books = await query.ToListAsync();
    }

    private async Task RemoveOwner(UserBook userBook)
    {
        var isbn = userBook.ISBN;

        Db.UserBooks.Remove(userBook);
        await Db.SaveChangesAsync();

        var hasAny = await Db.UserBooks.AnyAsync(u => u.ISBN == isbn);

        if (!hasAny)
        {
            var title = await Db.Titles.FindAsync(isbn);
            if (title != null)
            {
                Db.Titles.Remove(title);
                await Db.SaveChangesAsync();
            }
        }

        // Update the tiles
        await LoadBooks();

        // Just for UI
        selectedBook?.UserBooks.Remove(userBook);

        await InvokeAsync(StateHasChanged);
        
    }
}