@page "/search"
@using BookOrgWebapp.Data
@using BookOrgWebapp.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components

@inject AppDbContext Db

<PageTitle>Search</PageTitle>

<h1>Book Search</h1>

<div class="mb-3">
    <form action="/search" method="get" data-enhance data-permanent>
        <div class="input-group">
            <input class="form-control" type="search" name="searchTerm" value="@SearchTerm"
                   placeholder="Search by ISBN, Title, User, Email..." />

            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>
</div>

@if (!books.Any())
{
    <p><em>No matching books found.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ISBN</th>
                <th>UserID</th>
                <th>Book Name</th>
                <th>User</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in books)
            {
                <tr>
                    <td>@book.ISBN</td>
                    <td>@book.UserID</td>
                    <td>@book.Title.BookName</td>
                    <td>@book.User.Name</td>
                    <td>@book.User.Email</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    // Gets value from URL: /search?searchTerm=value
    [SupplyParameterFromQuery]
    private string? SearchTerm { get; set; }

    private List<UserBook> books = new();

    protected override async Task OnParametersSetAsync()
    {
        var query = Db.UserBooks
            .Include(b => b.Title)
            .Include(b => b.User)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            query = query.Where(b =>
                b.ISBN.Contains(SearchTerm) ||
                b.UserID.ToString().Contains(SearchTerm) ||
                b.Title.BookName.ToLower().Contains(SearchTerm.ToLower()) ||
                b.User.Name.ToLower().Contains(SearchTerm.ToLower()) ||
                b.User.Email.ToLower().Contains(SearchTerm.ToLower()));
        }

        books = await query.ToListAsync();
    }
}