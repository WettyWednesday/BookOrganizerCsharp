@page "/search"
@using BookOrgWebapp.Data
@using BookOrgWebapp.Models
@using BookOrgWebapp.Components.Books
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components
@rendermode InteractiveServer

@inject AppDbContext Db

<PageTitle>Search</PageTitle>

<h1>Book Search</h1>

<div class="mb-3">
    <form action="/search" method="get" data-enhance data-permanent>
        <div class="input-group">
            <input class="form-control" type="search" name="searchTerm" value="@SearchTerm"
                   placeholder="Search by ISBN, Title, User, Email..." />

            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>
</div>

@if (!books.Any())
{
    <p><em>No matching books found.</em></p>
}
else
{
    <div class="book-grid">
        @foreach (var book in books)
        {
            <BookCard Book="@book"
                    OnSelected="@(b => OpenBook(b))" />
            }
    </div>
}
@if (selectedBook != null)
{
    <BookDetailsModal Book="selectedBook"
                      OnClose="CloseModal" />
}

@code {

    // Gets value from URL: /search?searchTerm=value
    [SupplyParameterFromQuery]
    private string? SearchTerm { get; set; }

    private List<UserBook> books = new();
    
    private UserBook? selectedBook;

    private Task OpenBook(UserBook book)
    {
        selectedBook = book;
        return InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        selectedBook = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = Db.UserBooks
            .Include(b => b.Title)
            .Include(b => b.User)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            query = query.Where(b =>
                b.ISBN.Contains(SearchTerm) ||
                b.UserID.ToString().Contains(SearchTerm) ||
                b.Title.BookName.ToLower().Contains(SearchTerm.ToLower()) ||
                b.User.Name.ToLower().Contains(SearchTerm.ToLower()) ||
                b.User.Email.ToLower().Contains(SearchTerm.ToLower()));
        }

        books = await query.ToListAsync();
    }
}